{
	"name": "engineer-sns",
	"private": true,
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm --filter @engineer-sns/web build",
		"check": "vp check",
		"fix": "vp check --fix",
		"test": "vp run -r test",
		"e2e": "playwright test --project=e2e",
		"vrt": "playwright test --project=vrt-desktop",
		"vrt:update": "playwright test --project=vrt-desktop --update-snapshots",
		"db:types": "node scripts/gen-db-types.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "24.19.2",
		"supabase": "^3.1.0",
		"typescript": "7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@10.32.1"
}
