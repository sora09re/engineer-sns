{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "esnext"],
		"types": ["node"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true
	},
	"include": ["e2e", "playwright.config.ts", "vite.config.ts", "api"],
	"exclude": ["node_modules"]
}
